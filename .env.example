# ==============================================
# SMART PASTORALISM - ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and configure your values

# ============================================== 
# APPLICATION SETTINGS
# ==============================================
APP_NAME="Smart Pastoralism System"
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production-use-long-random-string

# ==============================================
# DATABASE
# ==============================================
LORA_DB_PATH=livestock_data.db
LORA_CHECK_INTERVAL=2

# ==============================================
# SERVER CONFIGURATION
# ==============================================
HOST=0.0.0.0
PORT=8000
RPI_HOST=192.168.1.12

# ==============================================
# ALERT THRESHOLDS
# ==============================================
# Temperature thresholds (Celsius)
TEMP_WARNING=39.0
TEMP_CRITICAL=39.5

# Heart rate thresholds (BPM)
HR_WARNING=75
HR_CRITICAL=80

# Battery level thresholds (%)
BATTERY_LOW=50
BATTERY_CRITICAL=20

# ==============================================
# EMAIL NOTIFICATIONS (SMTP)
# ==============================================
# Enable/disable email notifications
SMTP_ENABLED=False

# SMTP Server Configuration  
# For Gmail: smtp.gmail.com:587
# For Outlook: smtp-mail.outlook.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Email Credentials
# NOTE: For Gmail, use an "App Password" not your regular password
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Sender Information
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Smart Pastoralism Alerts

# Recipient Emails (comma-separated for multiple)
NOTIFICATION_EMAILS=farmer@example.com,vet@example.com

# ==============================================
# SMS NOTIFICATIONS (Twilio)
# ==============================================
# Enable/disable SMS notifications
SMS_ENABLED=False

# Twilio Credentials
# Get these from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Recipient Phone Numbers (comma-separated for multiple)
# Format: +[country_code][number], e.g., +12025551234
NOTIFICATION_PHONES=+1234567890,+9876543210

# ==============================================
# GEOFENCING
# ==============================================
# Enable/disable geofence violation alerts
GEOFENCE_ALERT_ENABLED=True

# How often to check geofences (seconds)
GEOFENCE_CHECK_INTERVAL=60

# ==============================================
# SETUP INSTRUCTIONS
# ==============================================
#
# 1. EMAIL SETUP (Gmail Example):
#    - Go to https://myaccount.google.com/security
#    - Enable 2-Step Verification
#    - Go to https://myaccount.google.com/apppasswords
#    - Generate an App Password
#    - Use that password for SMTP_PASSWORD
#    - Set SMTP_ENABLED=True
#
# 2. SMS SETUP (Twilio):
#    - Sign up at https://www.twilio.com
#    - Get a phone number from Twilio Console
#    - Copy Account SID and Auth Token
#    - Set SMS_ENABLED=True
#    - Install Twilio: pip install twilio
#
# 3. GEOFENCING SETUP:
#    - Geofences can be created via the web UI
#    - Go to Settings > Geof ences
#    - Click "Create New Geofence"
#    - Set center coordinates and radius
#
# ==============================================

# PawTrack: nearest vet hospital lookup for "Send details to vet" (WhatsApp)
PAWTRACK_API_URL=http://localhost:5000/api
# Used when PawTrack cannot be reached
VET_NAME=
VET_PHONE=
# Send every "Send details to vet" WhatsApp message to this one number (demo)
WHATSAPP_TO=
